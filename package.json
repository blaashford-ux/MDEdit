{
  "name": "mdedit",
  "version": "0.1.0",
  "description": "Folder-based Markdown editor that splits files into chapters by Heading 1",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outdir=dist-electron/electron --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.blaashford.mdedit",
    "productName": "MDEdit",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "node_modules/pagedjs/dist/paged.polyfill.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.21.5",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "docx": "^9.8.1",
    "fflate": "^0.8.3",
    "pagedjs": "^0.4.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
